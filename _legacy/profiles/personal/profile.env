# profiles/personal/profile.env
# Identity-level non-secret variables for the "personal" profile.
#
# Rules:
#   - AI_PROFILE and ANTHROPIC_MODEL are the only vars set here.
#   - Backend vars (ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_API_KEY)
#     are NEVER set here — they belong in backends/*.env (FR-7a).
#   - AI_OVERRIDE_INSTRUCTIONS is not used (Claude Code ignores it; FR-5).

export AI_PROFILE="personal"
export ANTHROPIC_MODEL="claude-sonnet-4-6"
