unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_BASE_URL
# backends/local.env
# Local LLM endpoint backend.
#
# FR-7  : exports ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN; does NOT
#         export ANTHROPIC_MODEL (identity-level — set by profile.env).
# FR-7a : the `unset` prelude on line 1 wipes any auth/base-url variables
#         left over from a prior `ai personal cloud-claude` invocation in
#         the same shell, guaranteeing exactly one auth mechanism is active.
#
# The token below is a placeholder accepted by most local LLM proxies
# (e.g., LiteLLM, Ollama proxies) that ignore the value but require the
# header to be present. Replace if your local proxy enforces a real token.

export ANTHROPIC_BASE_URL="http://127.0.0.1:8080"
export ANTHROPIC_AUTH_TOKEN="local-placeholder"
