unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_BASE_URL
# backends/cloud-claude.env
# Anthropic cloud backend.
#
# FR-7a : the `unset` prelude on line 1 wipes any auth/base-url variables
#         left over from a prior `ai personal local` invocation in the same
#         shell, guaranteeing exactly one auth mechanism is active.
# FR-8  : ANTHROPIC_API_KEY is read from an ignored file under keys/ (the
#         tracked file MUST NOT contain literal API key material).
#         ANTHROPIC_AUTH_TOKEN and ANTHROPIC_MODEL are NOT exported here.

export ANTHROPIC_BASE_URL="https://api.anthropic.com"

if [ ! -r "${AI_DOTFILES:-}/keys/anthropic.key" ]; then
  echo "cloud-claude.env: missing or unreadable \$AI_DOTFILES/keys/anthropic.key" >&2
fi
export ANTHROPIC_API_KEY="$(cat "${AI_DOTFILES:-}/keys/anthropic.key" 2>/dev/null)"
