# ai-dotfiles/.gitignore
# FR-11: keys/ and *.local.env MUST never be tracked.
keys/
*.local.env

# RES (Research / Spike / POC) lane — transient artifacts under sandbox.
# Per IMP-20260514-research-lane FR-10: notebook checkpoints, dataset
# dumps, scratch outputs in `research/<spec-id>/.tmp/` MUST NOT be committed.
research/*/.tmp/
research/**/.tmp/

**/skills/.system/*
**/skills/.system/.*

# Shared default tool-home state linked into profiles by ai-switch.
profiles/*/claude/*
profiles/*/claude/.*
!profiles/*/claude/CLAUDE.md
!profiles/*/claude/agents
!profiles/*/claude/boundaries.md
!profiles/*/claude/prompts
!profiles/*/claude/skills
!profiles/*/claude/spec-workflows
!profiles/*/claude/templates

profiles/*/copilot/*
profiles/*/copilot/.*
!profiles/*/copilot/copilot-instructions.md
!profiles/*/copilot/agents
!profiles/*/copilot/boundaries.md
!profiles/*/copilot/prompts
!profiles/*/copilot/skills
!profiles/*/copilot/spec-workflows
!profiles/*/copilot/templates

profiles/*/codex/*
profiles/*/codex/.*
!profiles/*/codex/AGENTS.md
!profiles/*/codex/agents
!profiles/*/codex/boundaries.md
!profiles/*/codex/prompts
!profiles/*/codex/skills
!profiles/*/codex/spec-workflows
!profiles/*/codex/templates
