# profiles/work/profile.env
# Identity-level non-secret variables for the "work" profile.
#
# Rules (FR-6, IMP-20260610-stabilize-profile-switching):
#   - AI_PROFILE is the ONLY variable set here. Model selection belongs to
#     the CLI session (per-spec `model-suggestion`, /model, or CLI flags) —
#     a profile-level pin silently downgrades every tool after model
#     generations advance.
#   - Backend vars (ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN,
#     ANTHROPIC_API_KEY) are NEVER set here — they belong in backends/*.env.

export AI_PROFILE="work"
